# Envoi d'emails pour le formulaire de contact uniquement
# (app/api/contact/route.ts, via lib/email.ts) — via Resend
# (https://resend.com, gratuit jusqu'à 3000 emails/mois). Le quiz
# /diagnostic ne passe plus par Resend : voir le bloc CRM_* plus bas,
# c'est le CRM (Edge Function leads-quiz) qui envoie l'email admin de son
# côté une fois la demande reçue.
#
# 1. Créez un compte Resend et récupérez une clé API.
# 2. RESEND_API_KEY : la clé API Resend.
# 3. CONTACT_TO_EMAIL : l'adresse qui doit recevoir les messages du
#    formulaire de contact (contact@amgrowthsolutions.fr).
# 4. CONTACT_FROM_EMAIL (optionnel) : expéditeur affiché. Sans domaine
#    vérifié sur Resend, laissez la valeur par défaut
#    "AM Growth Solutions <onboarding@resend.dev>" — fonctionne
#    immédiatement en test.
#
# Sans ces variables, le formulaire de contact affiche une erreur et
# renvoie vers WhatsApp/Calendly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="AM Growth Solutions <onboarding@resend.dev>"

# URL canonique du site (voir lib/site.ts) — à définir sur Vercel une fois
# le domaine définitif connu.
NEXT_PUBLIC_SITE_URL=

# Intégration avec le CRM (section "Site internet") — relais serveur
# uniquement (app/api/track, app/api/quiz-submit) : la clé n'est jamais
# exposée au navigateur. Sans CRM_SITE_EVENEMENT_URL/CRM_SITE_API_KEY, le
# tracking d'événements échoue silencieusement (aucun impact visiteur).
# Sans CRM_LEADS_QUIZ_URL/CRM_SITE_API_KEY, le quiz /diagnostic affiche
# une erreur claire à l'étape finale — c'est le seul canal d'envoi du
# quiz, il n'y a pas de repli email.
# CRM_SITE_API_KEY : la clé SITE_API_KEY générée pour les Edge Functions
#   Supabase site-evenement / leads-quiz.
# CRM_SITE_EVENEMENT_URL : URL complète de l'Edge Function site-evenement
#   (ex. https://<project-ref>.supabase.co/functions/v1/site-evenement).
# CRM_LEADS_QUIZ_URL : URL complète de l'Edge Function leads-quiz
#   (ex. https://<project-ref>.supabase.co/functions/v1/leads-quiz).
CRM_SITE_API_KEY=
CRM_SITE_EVENEMENT_URL=
CRM_LEADS_QUIZ_URL=
