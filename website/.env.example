# Envoi d'emails pour le formulaire de contact et le diagnostic
# (app/api/contact/route.ts, app/api/diagnostic/route.ts, via
# lib/email.ts) — via Resend (https://resend.com, gratuit jusqu'à 3000
# emails/mois).
#
# 1. Créez un compte Resend et récupérez une clé API.
# 2. RESEND_API_KEY : la clé API Resend.
# 3. CONTACT_TO_EMAIL : l'adresse qui doit recevoir les messages/leads
#    (contact@amgrowthsolutions.fr).
# 4. CONTACT_FROM_EMAIL (optionnel) : expéditeur affiché. Sans domaine
#    vérifié sur Resend, laissez la valeur par défaut
#    "AM Growth Solutions <onboarding@resend.dev>" — fonctionne
#    immédiatement en test. Un domaine vérifié (ex. contact@amgrowthsolutions.fr)
#    est nécessaire pour envoyer le diagnostic détaillé au visiteur avec
#    une adresse d'expéditeur propre — voir resend.com/domains.
#
# Sans ces variables, le formulaire de contact et le diagnostic affichent
# une erreur et renvoient vers WhatsApp/Calendly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="AM Growth Solutions <onboarding@resend.dev>"

# URL canonique du site (voir lib/site.ts) — à définir sur Vercel une fois
# le domaine définitif connu.
NEXT_PUBLIC_SITE_URL=
